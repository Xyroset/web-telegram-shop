  "admin_notifications": {
    "telegram": {
      "order_paid_physical": "<b>A new order has been successfully paid.</b>\n\n<b>--- Order Details ---</b>\n<b>Order ID:</b> <code>{order_id}</code>\n<b>User Id:</b> <code>{tg_id}</code>\n<b>Full name:</b> {full_name}\n<b>Username:</b> @{tg_username}\n<b>User Email:</b> {email}\n<b>User Phone:</b> {phone}\n<b>Total Amount:</b> ${amount_usd}\n<b>State:</b> {order_state}\n\n<b>--- Items to Pack ---</b>\n{physical_items}\n\n<b>--- Delivery Info ---</b>\n<b>Shipping Strategy:</b> {provider_code}\n<b>Delivery Cost:</b> ${delivery_cost}\n<b>Country/Zone:</b> {zone_upper} ({zone_name})\n<b>Region:</b> {region_upper} ({region_name})\n<b>Zip code:</b> {zip_code}\n<b>Address:</b> {address}\n\n<i>Please check the admin panel</i>\n<a href=\"{admin_url}\">Admin panel</a>",
      "transaction_failed": "<b>The transaction is Failed!</b>\n\n<b>--- Order Details ---</b>\n<b>Order ID:</b> <code>{order_id}</code>\n<b>User Id:</b> <code>{tg_id}</code>\n<b>Full name:</b> {full_name}\n<b>Username:</b> @{tg_username}\n<b>User Email:</b> {email}\n<b>User Phone:</b> {phone}\n<b>Total Amount:</b> ${amount_usd}\n<b>State:</b> {order_state}\n\n<b>--- Transaction Info ---</b>\n<b>Transaction ID:</b> <code>{tx_id}</code>\n<b>Invoice ID:</b> <code>{invoice_id}</code>\n<b>Payment Currency:</b> {currency}\n<b>Network:</b> {network}\n<b>Target amount USD:</b> <code>{target_usd}</code>\n<b>Amount crypto:</b> <code>{amount_crypto}</code>\n<b>Current amount crypto:</b> <code>{current_crypto}</code>\n<b>Captured amount USD:</b> {captured_usd}\n<b>Receiver address:</b> <code>{receiver_address}</code>\n<b>Sender address:</b> <code>{sender_address}</code>\n<b>Tx hash:</b> <code>{tx_hash}</code>\n<b>State:</b> {tx_state}\n<b>Raw response provider:</b> {raw_response}\n\n<a href=\"{admin_url}\">Admin panel</a>",
      "support": "#Ticket_{ticket_id}\n\n<b>New Support Request ({state})</b>\n<b>User:</b> @{tg_username} (ID: <code>{tg_id}</code>)\n<b>Category:</b> {category}\n\n<i>{message}</i>\n\n<a href=\"{admin_url}\">Admin panel</a>",
      "system": "<b>SYSTEM ALERT: {level}</b>\n<b>Source:</b> {source}\n\n<code>{error_message}</code>",
      "buttons": {
        "accept": "Accept",
        "reject": "Reject"
      }
    },
    "emails": {
      "order_paid_subject": "New Order Paid: #{order_id}",
      "order_paid_message": "A new order has been successfully paid.\n\n--- Order Details ---\nOrder ID: {order_id}\nUser Id: {tg_id}\nFull name: {full_name}\nUsername: @{tg_username}\nUser Email: {email}\nUser Phone: {phone}\nTotal Amount: ${amount_usd}\nState: {order_state}\n\n--- Delivery Info ---\nShipping Strategy: {provider_code}\nDelivery Cost: ${delivery_cost}\nCountry/Zone: {zone_upper} ({zone_name})\nRegion: {region_upper} ({region_name})\nZip code: {zip_code}\nAddress: {address}\n\nPlease check the admin panel.\nAdmin panel: {admin_url}",

      "transaction_failed_subject": "Failed transaction: #{tx_id}",
      "transaction_failed_message": "The transaction is Failed!\n\n--- Order Details ---\nOrder ID: {order_id}\nUser Id: {tg_id}\nFull name: {full_name}\nUsername: @{tg_username}\nUser Email: {email}\nUser Phone: {phone}\nTotal Amount: ${amount_usd}\nState: {order_state}\n\n--- Transaction Info ---\nTransaction ID: {tx_id}\nInvoice ID: {invoice_id}\nPayment Currency: {currency}\nNetwork: {network}\nTarget amount USD: {target_usd}\nAmount crypto: {amount_crypto}\nCurrent amount crypto: {current_crypto}\nCaptured amount USD: {captured_usd}\nReceiver address: {receiver_address}\nSender address: {sender_address}\nTX hash: {tx_hash}\nState: {tx_state}\nRaw response provider: {raw_response}\n\nAdmin panel: {admin_url}",

      "support_subject": "Support Request: #{ticket_id}",
